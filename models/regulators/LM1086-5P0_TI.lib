***************************** Basic Components *****************************
*$
.SUBCKT COMP_BASIC_GEN__LM10865P0 INP INM Y PARAMS: VDD=1 VSS=0 VTHRESH=0.5	
E_ABM Yint 0 VALUE {IF (V(INP) > 
+ V(INM), {VDD},{VSS})}
R1 Yint Y 1
C1 Y 0 1n
.ENDS COMP_BASIC_GEN__LM10865P0
*$
.SUBCKT D_D__LM10865P0 1 2
D1 1 2 DD1
.MODEL dd1 d (Is = 1E-15 N = 0.1 TT = 10p)
.ENDS D_D__LM10865P0
*$
.SUBCKT RVAR__LM10865P0 101 102 201 202 PARAMS: RREF=1
* nodes : 101 102 : nodes between which variable resistance is placed
* 201 202 : nodes to whose voltage the resistance is proportional
* parameters : rref : reference value of the resistance
rin 201 202 1G; input resistance
r 301 0 {rref}
fcopy 0 301 vsense 1; copy output current thru Z
eout 101 106 poly(2) 201 202 301 0 0 0 0 0 1; multiply VoverZ with Vctrl
vsense 106 102 0; sense iout
.ENDS RVAR__LM10865P0
*$
.SUBCKT D_D1__LM10865P0 1 2
D1 1 2 DD1
.MODEL DD1 D (IS = 1E-15 N = 0.1 TT = 10p)
.ENDS D_D1__LM10865P0
*$
