*
* Model Usage Notes:
*
* A. Features have been modelled
*	1. Startup & Shutdown Response 
*	2. 2.7A Peak Current Limit
*	3. Dropout Voltage vs Output Current  
*	4. Line & Load Transient Response 
*	5. VOUT vs VIN Plot
*	6. VOUT vs IOUT Plot
*
* B. Features haven't been modelled
*	1. Ground pin quiescent current
*	2. Ripple Regulation Response vs Output Current/Frequency 
*	3. Temperature dependent characteristics & Output Noise Voltage
*   4. This model do not support the inverting configuration.
*****************************************************************************
.SUBCKT LM1086-5P0_TRANS INPUT GND OUTPUT
X_F1    VZZ N16902334 N16902368 VYY LM1086-5P0V_F1__LM10865P0 
X_U8         INPUT OUTPUT ILIM 0 my_ETABLE__LM10865P0
C_C3         VYY 0  100p  
X_S1    N16902539 0 INPUT N16902368 LM1086-5P0V_S1__LM10865P0 
R_R5         VZZ VYY  {ROUT}  
E_ABM2         N16902633 0 VALUE { IF(V(IN_OK) > 0.5, 1, 0)    }
C_C6         N16902368 0  100n  
X_S2    IN_OK 0 N16902267 OUTPUT LM1086-5P0V_S2__LM10865P0 
C_C5         N16902539 0  1n  
R_R7         N16902539 N16902633  100 TC=0,0 
R_Rbot         ADJ GND  363 TC=0,0 
R_Rtop         OUTPUT ADJ  121 TC=0,0 
R_U1_R6         U1_N15543801 U1_VDO  10  
R_U1_R2         0 U1_N15555780  1G  
E_U1_ABM4         U1_N15555938 0 VALUE {
+  V(U1_N15543421)*(ABS(V(OUTPUT))/(ABS(V(OUTPUT)-V(ADJ))))    }
E_U1_ABM6         U1_N15543747 0 VALUE { IF(V(IN_OK) > 0.5, V(U1_N15543395), 0)
+     }
R_U1_R1         0 U1_N15543421  1G  
V_U1_V1         U1_N15543395 0 1.25
C_U1_C4         U1_VDO 0  1n  TC=0,0 
E_U1_E3         U1_N15543801 0 TABLE { V(ISENSE, 0) } 
+ ( (0,0.9)(0.5,1)((1,1.1)(1.25,1.2)(1.5,1.3) )
V_U1_V5         U1_N15543883 0 1.01
R_U1_R5         U1_N15543687 N16902490  1 TC=0,0 
X_U1_U7         INPUT U1_N15543883 IN_OK COMP_BASIC_GEN__LM10865P0 PARAMS: VDD=1 VSS=0
+  VTHRESH=0.5
C_U1_C3         N16902490 0  10p  
E_U1_ABM5         U1_N15543687 0 VALUE { MIN(V(U1_N15555780),  
+ MAX(V(INPUT) - V(U1_VDO), 0))   }
C_U1_C2         U1_N15555780 0  10p  
C_U1_C1         U1_N15543421 0  {1e-6*SQRT(TTRN)}  
R_U1_R4         U1_N15555938 U1_N15555780  1 TC=0,0 
R_U1_R3         U1_N15543747 U1_N15543421  {3.333e5*SQRT(TTRN)} TC=0,0 
R_R6         N16902639 VYY  10 TC=0,0 
E_ABM1         N16902639 0 VALUE { MIN(V(VXX), (V(Vzz)+(V(ILIM)*ROUT)))    }
X_U2         0 OUTPUT D_D__LM10865P0 PARAMS:
R_R2         N16902490 VXX  {PSRR*RINP}  
C_C1         VXX N16902368  {1/(6.28*RINP*POLE)}  
C_C2         N16902490 VXX  {1/(6.28*PSRR*RINP*ZERO*1)}  
X_H1    N16902334 N16902267 ISENSE 0 LM1086-5P0V_H1__LM10865P0 
R_R1         N16902368 VXX  {RINP}  
.PARAM  psrr=316.227u pole=1k rinp=10e6 zero=100k rout=1m ttrn=1u vref=1.25
.ENDS LM1086-5P0_TRANS
