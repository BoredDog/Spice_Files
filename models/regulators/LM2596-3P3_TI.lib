.SUBCKT D_D1__LM25963P3 1 2
d1 1 2 dd1
.model dd1 d
+ is=1e-015
+ tt=1e-011
+ rs=0.05
+ n=0.1
.ENDS D_D1__LM25963P3
*$
.SUBCKT srlatchrhp_basic_gen__LM25963P3 s r q qb params: vdd=1 vss=0 vthresh=0.5 
gq 0 qint value = {if(v(r) > {vthresh},-5,if(v(s)>{vthresh},5, 0))}
cqint qint 0 1n
rqint qint 0 1000meg
d_d10 qint my5 D_D1__LM25963P3
v1 my5 0 {vdd}
d_d11 myvss qint D_D1__LM25963P3
v2 myvss 0 {vss} 
eq qqq 0 qint 0 1
x3 qqq qqqd1 BUF_BASIC_GEN__LM25963P3 params: vdd={vdd} vss={vss} vthresh={vthresh}
rqq qqqd1 q 1
eqb qbr 0 value = {if( v(q) > {vthresh}, {vss},{vdd})}
rqb qbr qb 1 
cdummy1 q 0 1n 
cdummy2 qb 0 1n
.ic v(qint) {vss}
.model D_D1__LM25963P3 d
+ is=1e-015
+ tt=1e-011
+ rs=0.05
+ n=0.1
.ENDS srlatchrhp_basic_gen__LM25963P3
