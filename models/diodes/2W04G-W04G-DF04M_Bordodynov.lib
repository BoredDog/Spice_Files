.subckt DF04M 1 2 3 4 
D1 2 4 DI_DF04M
D2 1 4 DI_DF04M
D3 3 2 DI_DF04M
D4 3 1 DI_DF04M
.MODEL DI_DF04M D (IS=4.42n RS=42.0m BV=400 IBV=10.0u CJO=65.0p M=0.333 N=1.70 TT=4.32u)
.ends DF04M

.subckt W04G  1 2 3 4 
